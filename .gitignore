# Python virtual environments
venv/
backend/venv/

# Node packages
node_modules/
frontend/node_modules/

# Python compilation and caching
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables (`.env` preferred; legacy `env` also used)
.env
backend/.env
backend/env
frontend/.env
*.local

# Datasets and cache directory (heavy files)
/data/

# Machine learning model artifacts and serialized data
*.pkl
*.joblib

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
dist/
build/

# ---- Free-tier go-live (docs/GO_LIVE.md) ----
# Never commit secrets or local databases anywhere in the tree.
**/.env
.env.*
!.env.example
!**/.env.example
backend/env
*.db
*.db-journal
*.sqlite3
# Slim runtime bundle (models + slim npz, ~23 MB) IS committed so GitHub-built hosts
# (Render / Hugging Face) have the trained models. Rebuild: scripts/build_deploy_bundle.py
!deploy/
!deploy/data/
!deploy/data/**
!deploy/data/**/*.joblib

# Local scratch / logs (never deploy these)
*.log
.cascadyx_servers.json
.pytest_cache/
.pytest_full_out.txt
