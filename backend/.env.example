# Copy this file to `.env` (preferred) or `env` (legacy filename also supported).
# backend/app/config.py loads `.env` first, then falls back to `env`.

# Nebius AI Studio (OpenAI-compatible) — SENTINEL AI chat + XAI prose
# Docs: https://docs.tokenfactory.nebius.com/api-reference/introduction
# Base URL: https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=YOUR_NEBIUS_API_KEY
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Strong instruct model with demo-friendly latency (MoE ~30B / A3B active).
# Alternatives: Qwen/Qwen3-235B-A22B-Instruct-2507 (stronger, slower),
#               openai/gpt-oss-120b, nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# JSON Web Token Secret for user authentication and authorization
# Required for stable sessions on any shared/public deploy (see docs/DEPLOY.md).
JWT_SECRET=

# Optional: override default SQLite path (data/cache/app.db)
# DATABASE_URL=sqlite:///D:/Final_Year_Project/data/cache/app.db

# Lifetime Nebius (LLM) questions per user (rule-based answers do not count)
# AI_QUERY_LIMIT=10

# Google Sign-In / OAuth — store ONLY in backend/.env (or backend/env). Never commit secrets.
# Client ID is public (also exposed via GET /api/auth/google/config for GIS).
# Client secret stays server-side for authorization-code exchange (redirect + GIS popup).
# See docs/GO_LIVE.md Step 5 for exact Google Cloud Console origins / redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local redirect-flow callback (must match Console "Authorized redirect URIs" exactly):
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
# Production example (also add this URI in Google Cloud Console):
# GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback
# Extra SPA origins allowed as post-login ``next`` targets (comma-separated):
# GOOGLE_FRONTEND_ORIGINS=https://YOUR_DOMAIN

# Legacy (optional, unused by chat path after Nebius migration)
# GEMINI_API_KEYS=YOUR_KEY_1,YOUR_KEY_2,YOUR_KEY_3

# Seed password for the first admin account (blank = random value printed once at first startup)
ADMIN_SEED_PASSWORD=
# Set to 1 to start the Live Lab sensor watcher on boot (admins can also toggle it in the UI)
LAB_SENSOR_WATCH=0

# --- Public deployment only (leave unset locally). See docs/DEPLOY.md ---
# PUBLIC_MODE=1 hides /docs, adds security headers, disables PCAP uploads, requires JWT_SECRET.
# PUBLIC_MODE=1
# Canonical public origin (https, no trailing slash). Auto-added to CORS + Google allow-list,
# and used to derive GOOGLE_REDIRECT_URI when that is blank.
# PUBLIC_BASE_URL=https://cascadyx.app
# Extra CORS origins, comma-separated (e.g. the www host):
# CORS_ORIGINS=https://www.cascadyx.app
# Shorter login sessions on the public site (local default is 365):
# ACCESS_TOKEN_EXPIRE_DAYS=14
# Free hosting (Render / Hugging Face): PUBLIC_BASE_URL is auto-detected from RENDER_EXTERNAL_URL / SPACE_HOST.
# PUBLIC_MODE=1 now also makes the app refuse to start unless JWT_SECRET (>=32 chars) and
# ADMIN_SEED_PASSWORD (>=12 chars) are set. See docs/GO_LIVE.md.
